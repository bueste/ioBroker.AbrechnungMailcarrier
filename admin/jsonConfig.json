{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_connection": {
            "type": "panel",
            "label": "connectionTab",
            "items": {
                "_hintConnection": {
                    "type": "staticText",
                    "text": "hintConnectionText",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "apiUrl": {
                    "type": "text",
                    "label": "apiUrl",
                    "help": "apiUrlHelp",
                    "newLine": true,
                    "trim": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "apiToken": {
                    "type": "password",
                    "label": "apiToken",
                    "help": "apiTokenHelp",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "_testConnection": {
                    "type": "sendTo",
                    "label": "testConnection",
                    "command": "testConnection",
                    "jsonData": "{ \"apiUrl\": \"${data.apiUrl}\", \"apiToken\": \"${data.apiToken}\" }",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_source": {
            "type": "panel",
            "label": "sourceTab",
            "items": {
                "sourceType": {
                    "type": "select",
                    "label": "sourceType",
                    "help": "sourceTypeHelp",
                    "options": [
                        {
                            "label": "sourceSolarlog",
                            "value": "solarlogJournal"
                        },
                        {
                            "label": "sourceCounters",
                            "value": "counters"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "journalStateId": {
                    "type": "objectId",
                    "types": "state",
                    "label": "journalStateId",
                    "help": "journalStateIdHelp",
                    "hidden": "data.sourceType !== 'solarlogJournal'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "snapshotTime": {
                    "type": "text",
                    "label": "snapshotTime",
                    "help": "snapshotTimeHelp",
                    "hidden": "data.sourceType !== 'counters'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3,
                    "trim": true,
                    "validator": "/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/.test(data.snapshotTime)",
                    "validatorErrorText": "snapshotTimeInvalid"
                },
                "staleMinutes": {
                    "type": "number",
                    "label": "staleMinutes",
                    "help": "staleMinutesHelp",
                    "unit": "min",
                    "min": 1,
                    "max": 1440,
                    "hidden": "data.sourceType !== 'counters'",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "meters": {
                    "type": "table",
                    "label": "metersTable",
                    "help": "metersTableHelp",
                    "hidden": "data.sourceType !== 'counters'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "unitName",
                            "width": "20%"
                        },
                        {
                            "type": "objectId",
                            "types": "state",
                            "attr": "stateId",
                            "title": "energyState",
                            "width": "45%"
                        },
                        {
                            "type": "select",
                            "attr": "unit",
                            "title": "unit",
                            "width": "10%",
                            "options": [
                                {
                                    "label": "kWh",
                                    "value": "kWh"
                                },
                                {
                                    "label": "Wh",
                                    "value": "Wh"
                                }
                            ],
                            "default": "kWh"
                        },
                        {
                            "type": "select",
                            "attr": "mode",
                            "title": "mode",
                            "width": "15%",
                            "options": [
                                {
                                    "label": "modeCounter",
                                    "value": "counter"
                                },
                                {
                                    "label": "modeDaily",
                                    "value": "daily"
                                }
                            ],
                            "default": "counter"
                        }
                    ]
                },
                "production": {
                    "type": "table",
                    "label": "productionTable",
                    "help": "productionTableHelp",
                    "hidden": "data.sourceType !== 'counters'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "objectId",
                            "types": "state",
                            "attr": "stateId",
                            "title": "energyState",
                            "width": "65%"
                        },
                        {
                            "type": "select",
                            "attr": "unit",
                            "title": "unit",
                            "width": "10%",
                            "options": [
                                {
                                    "label": "kWh",
                                    "value": "kWh"
                                },
                                {
                                    "label": "Wh",
                                    "value": "Wh"
                                }
                            ],
                            "default": "kWh"
                        },
                        {
                            "type": "select",
                            "attr": "mode",
                            "title": "mode",
                            "width": "15%",
                            "options": [
                                {
                                    "label": "modeCounter",
                                    "value": "counter"
                                },
                                {
                                    "label": "modeDaily",
                                    "value": "daily"
                                }
                            ],
                            "default": "counter"
                        }
                    ]
                },
                "feedin": {
                    "type": "table",
                    "label": "feedinTable",
                    "help": "feedinTableHelp",
                    "hidden": "data.sourceType !== 'counters'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "objectId",
                            "types": "state",
                            "attr": "stateId",
                            "title": "energyState",
                            "width": "65%"
                        },
                        {
                            "type": "select",
                            "attr": "unit",
                            "title": "unit",
                            "width": "10%",
                            "options": [
                                {
                                    "label": "kWh",
                                    "value": "kWh"
                                },
                                {
                                    "label": "Wh",
                                    "value": "Wh"
                                }
                            ],
                            "default": "kWh"
                        },
                        {
                            "type": "select",
                            "attr": "mode",
                            "title": "mode",
                            "width": "15%",
                            "options": [
                                {
                                    "label": "modeCounter",
                                    "value": "counter"
                                },
                                {
                                    "label": "modeDaily",
                                    "value": "daily"
                                }
                            ],
                            "default": "counter"
                        }
                    ]
                }
            }
        }
    }
}
