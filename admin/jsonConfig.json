{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_connection": {
            "type": "panel",
            "label": "connectionTab",
            "items": {
                "_hintConnection": {
                    "type": "staticText",
                    "text": "hintConnectionText",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "host": {
                    "type": "text",
                    "label": "host",
                    "help": "hostHelp",
                    "newLine": true,
                    "trim": true,
                    "validator": "/^(https?:\\/\\/)?([a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?|\\[[0-9a-fA-F:]+\\])(:[0-9]{1,5})?\\/*$/.test(data.host)",
                    "validatorErrorText": "hostInvalid",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "apiPath": {
                    "type": "text",
                    "label": "apiPath",
                    "help": "apiPathHelp",
                    "newLine": true,
                    "trim": true,
                    "validator": "/^\\/?([A-Za-z0-9._~-]+\\/?)+$/.test(data.apiPath)",
                    "validatorErrorText": "apiPathInvalid",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "apiToken": {
                    "type": "password",
                    "label": "apiToken",
                    "help": "apiTokenHelp",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "_testConnection": {
                    "type": "sendTo",
                    "label": "testConnection",
                    "command": "testConnection",
                    "jsonData": "{ \"host\": \"${data.host}\", \"apiPath\": \"${data.apiPath}\", \"apiToken\": \"${data.apiToken}\" }",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
