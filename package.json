{
    "name": "iobroker.abrechnungmailcarrier",
    "version": "0.1.4",
    "description": "Delivers the daily consumption figures of apartments (solar/grid split) from ioBroker to the Abrechnung Mailcarrier billing web application over an authenticated HTTPS API.",
    "author": "Stefan Bühler <iobroker@mailcarrier.ch>",
    "homepage": "https://github.com/bueste/ioBroker.AbrechnungMailcarrier",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "billing",
        "abrechnung",
        "zev",
        "solar",
        "photovoltaik",
        "pv",
        "shelly",
        "solarlog",
        "nebenkosten"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bueste/ioBroker.AbrechnungMailcarrier.git"
    },
    "bugs": {
        "url": "https://github.com/bueste/ioBroker.AbrechnungMailcarrier/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "os": [
        "linux",
        "darwin",
        "win32"
    ],
    "main": "main.js",
    "files": [
        "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
        "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
        "lib/",
        "io-package.json",
        "LICENSE",
        "main.js"
    ],
    "scripts": {
        "test:unit": "mocha test/unit --exit",
        "test:package": "mocha test/package --exit",
        "test": "npm run test:unit && npm run test:package",
        "check": "tsc --noEmit -p tsconfig.check.json",
        "test:integration": "mocha test/integration --exit",
        "lint": "eslint .",
        "translate": "translate-adapter",
        "release": "release-script"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.0",
        "@iobroker/types": "^7.2.5",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^22.20.2",
        "chai": "^4.5.0",
        "mocha": "^10.8.2",
        "typescript": "~6.0.3"
    }
}
